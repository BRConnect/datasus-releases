NODE_ENV=development
PORT=3333
HOST=0.0.0.0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/survey
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
ANONYMOUS_RESPONSE_SECRET=replace-with-at-least-32-random-characters
ANONYMOUS_RESPONSE_WINDOW_HOURS=24
PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:3333
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=1 minute
RATE_LIMIT_REFRESH_MAX=10
RATE_LIMIT_REFRESH_WINDOW=1 minute
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
